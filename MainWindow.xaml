<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ToonTwisterNative.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:media="clr-namespace:System.Windows.Media.Media3D;assembly=PresentationCore" Title="Nickelodeon Toon Twister 3-D — Native" Icon="Resources/ToonTwister.ico" Width="1400" Height="920" MinWidth="1000" MinHeight="760" Background="#F57816" Foreground="#183C32" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#ECF7C5" />
      <Setter Property="Foreground" Value="#153E31" />
      <Setter Property="BorderBrush" Value="#589E54" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#FFF0A8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#B9E385" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#F7FAD9" />
      <Setter Property="BorderBrush" Value="#75AA5D" />
      <Setter Property="Foreground" Value="#153E31" />
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="36" />
      <RowDefinition x:Name="SceneRow" Height="*" MinHeight="200" />
      <RowDefinition Height="7" />
      <RowDefinition x:Name="ToolRow" Height="180" MinHeight="140" />
      <RowDefinition Height="7" />
      <RowDefinition x:Name="TimelineRow" Height="230" MinHeight="140" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Nieuw" Click="NewProject_Click" />
        <Button Content="Openen" Click="OpenProject_Click" />
        <Button Content="Opslaan" Click="SaveProject_Click" ToolTip="Project opslaan (Ctrl+S)" /><Button Content="MP4 exporteren" Click="ExportMp4_Click" />
        <Button x:Name="PreviewButton" Content="▶ Film afspelen" Click="Preview_Click" />
        <Button Content="⚙ Instellingen" Click="Settings_Click" /><Button Content="Indeling" Click="LayoutMenu_Click" />
      </StackPanel>
      <TextBlock Text="nickelodeon  TOON TWISTER 3-D" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
    </DockPanel>
    <DockPanel Grid.Row="1">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button Content="1  Prep" Tag="Prep" Click="StudioMode_Click" Padding="24,4" />
        <Button Content="2  Direct" Tag="Direct" Click="StudioMode_Click" Padding="24,4" />
        <Button Content="3  Edit" Tag="Edit" Click="StudioMode_Click" Padding="24,4" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="◀" Tag="-1" Click="ChangeScene_Click" Padding="8,3" />
        <TextBlock x:Name="SceneLabel" Text="Scène 1 / 1" Foreground="White" VerticalAlignment="Center" />
        <Button Content="▶" Tag="1" Click="ChangeScene_Click" Padding="8,3" />
        <Button Content="＋ Scène" Click="AddScene_Click" Padding="8,3" />
        <TextBlock x:Name="ModeHint" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="White" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="2" Margin="0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ActorColumn" Width="160" MinWidth="120" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition x:Name="InspectorColumn" Width="220" MinWidth="170" />
      </Grid.ColumnDefinitions>
      <Border Background="#E8F5C9" CornerRadius="7" Padding="8" Margin="0,0,6,0">
        <DockPanel>
          <TextBlock Text="IN JE SCÈNE" FontWeight="Bold" DockPanel.Dock="Top" Margin="3,4,0,10" />
          <Button DockPanel.Dock="Bottom" Content="＋ OBJ importeren" Click="ImportModel_Click" Padding="6" />
          <Button x:Name="LibraryToggle" DockPanel.Dock="Bottom" Content="Bibliotheek" Click="LibraryToggle_Click" />
          <ListBox x:Name="ObjectList" SelectionChanged="ObjectList_SelectionChanged" />
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Border x:Name="ViewportFrame" Background="#15241E" BorderBrush="#24382B" BorderThickness="3" ClipToBounds="True" SizeChanged="ViewportFrame_SizeChanged" PreviewMouseDown="Viewport_MouseDown" PreviewMouseMove="Viewport_MouseMove" PreviewMouseUp="Viewport_MouseUp" PreviewMouseWheel="Viewport_MouseWheel">
          <Viewport3D x:Name="SceneViewport" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewport3D.Camera>
              <media:PerspectiveCamera Position="0,3.57,9.64" LookDirection="0,-1.8,-9.64" FieldOfView="26.23" NearPlaneDistance="0.02" FarPlaneDistance="1000" />
            </Viewport3D.Camera>
            <media:ModelVisual3D>
              <media:ModelVisual3D.Content>
                <media:AmbientLight Color="White" />
              </media:ModelVisual3D.Content>
            </media:ModelVisual3D>
          </Viewport3D>
        </Border>
        <DockPanel Grid.Row="1">
          <Button DockPanel.Dock="Right" Content="Camera reset" Click="ResetCamera_Click" Padding="8,3" />
          <TextBlock x:Name="AspectLabel" Text="16:9" VerticalAlignment="Center" Foreground="White" />
          <TextBlock Text=" · Sleep acteur: verplaats · Rechts slepen: camera · Wiel: zoom" Foreground="White" FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
      </Grid>
      <Border Grid.Column="4" Background="#E8F5C9" CornerRadius="7" Padding="9" Margin="6,0,0,0" x:Name="InspectorHost">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="GESELECTEERD" FontWeight="Bold" />
            <TextBlock x:Name="SelectedObjectText" Text="Kies een acteur of prop" TextWrapping="Wrap" Margin="0,6,0,10" />
            <UniformGrid Columns="2">
              <TextBlock Text="Links / rechts" />
              <TextBox x:Name="XBox" Text="0" LostFocus="Transform_Changed" KeyDown="Transform_KeyDown" />
              <TextBlock Text="Hoogte" />
              <TextBox x:Name="YBox" Text="0" LostFocus="Transform_Changed" KeyDown="Transform_KeyDown" />
              <TextBlock Text="Diepte" />
              <TextBox x:Name="ZBox" Text="0" LostFocus="Transform_Changed" KeyDown="Transform_KeyDown" />
              <TextBlock Text="Draaien" />
              <TextBox x:Name="RotationBox" Text="0" LostFocus="Transform_Changed" KeyDown="Transform_KeyDown" />
              <TextBlock Text="Grootte" />
              <TextBox x:Name="ScaleBox" Text="1" LostFocus="Transform_Changed" KeyDown="Transform_KeyDown" />
            </UniformGrid>
            <CheckBox x:Name="OutlineEnabled" Content="Zwarte contour" IsChecked="True" Margin="3,8,3,0" Checked="Outline_Changed" Unchecked="Outline_Changed" />
            <DockPanel Margin="3,2,3,6">
              <TextBlock x:Name="OutlineWidthText" Text="Dikte 2,5%" Width="78" VerticalAlignment="Center" />
              <Slider x:Name="OutlineWidthSlider" Minimum="0" Maximum="8" Value="2.5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OutlineWidth_Changed" ToolTip="Contourdikte als percentage van de modelgrootte" />
            </DockPanel>
            <Button Content="In beeld zetten" Click="FocusSelection_Click" />
            <UniformGrid Columns="2">
              <Button Content="Kopie" Click="DuplicateObject_Click" Padding="6" />
              <Button Content="Wissen" Click="DeleteObject_Click" Padding="6" />
            </UniformGrid>
            <TextBlock Text="Beeldformaat" Margin="0,8,0,0" />
            <ComboBox x:Name="AspectCombo" SelectedIndex="1" SelectionChanged="Aspect_Changed">
              <ComboBoxItem Content="21:9 ultrawide" />
              <ComboBoxItem Content="16:9 origineel" />
              <ComboBoxItem Content="4:3" />
            </ComboBox>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#90BC68" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Sleep om het paneel breder of smaller te maken" />
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#90BC68" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Sleep om het paneel breder of smaller te maken" />
    </Grid>
    <Border Grid.Row="4" Background="#D7EEAF" CornerRadius="7" Padding="7" Margin="0,0,0,6" x:Name="ToolboxHost">
      <Grid>
        <Grid x:Name="LibraryPane">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Button Content="Sets / decors" Tag="1" Click="Category_Click" />
            <Button Content="Actors / personages" Tag="0" Click="Category_Click" />
            <Button Content="Props / voorwerpen" Tag="2" Click="Category_Click" />
          </StackPanel>
          <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
              <ComboBox x:Name="AssetCategory" Width="160" SelectedIndex="1" SelectionChanged="AssetCategory_Changed">
                <ComboBoxItem Content="Actors" />
                <ComboBoxItem Content="Sets" />
                <ComboBoxItem Content="Props" />
              </ComboBox>
              <TextBox x:Name="AssetSearch" Width="210" ToolTip="Zoek een naam" TextChanged="AssetSearch_TextChanged" />
            </StackPanel>
            <ListBox x:Name="AssetList" SelectionChanged="AssetList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Width="130" MinHeight="46" Margin="3" Padding="5" Background="#F6FAD8" BorderBrush="#95B863" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                      <Image Source="{Binding Thumbnail}" Width="112" Height="58" Stretch="Uniform" />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <StackPanel Grid.Column="2" Margin="8,0">
            <TextBlock x:Name="AssetInfoText" Text="Kies een decor of personage" TextWrapping="Wrap" FontSize="11" />
            <Button x:Name="AddAssetButton" Content="✓ Plaats in scène" Click="AddAsset_Click" Margin="0,7,0,0" />
          </StackPanel>
        </Grid>
        <Grid x:Name="DirectPane" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <ComboBox x:Name="ToolCombo" SelectedIndex="0" SelectionChanged="SoundTool_Changed">
              <ComboBoxItem Content="Act — acties" />
              <ComboBoxItem Content="Talk — stem" />
              <ComboBoxItem Content="Music — muziek" />
              <ComboBoxItem Content="SFX — effecten" /><ComboBoxItem Content="Eigen audio" />
            </ComboBox>
            <TextBlock Text="ACT — originele acties" FontWeight="Bold" Margin="3" />
            <ComboBox x:Name="ActionCategory" SelectedIndex="2" SelectionChanged="ActionCategory_Changed">
              <ComboBoxItem Content="Walks — lopen" />
              <ComboBoxItem Content="Moods — emoties" />
              <ComboBoxItem Content="Actions — acties" /><ComboBoxItem Content="Studio — nieuwe bewegingen" />
            </ComboBox>
          </StackPanel>
          <ListBox Grid.Column="1" x:Name="ActionList" Margin="6,0" SelectionChanged="ActionChoice_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="LibraryClip_MouseDown" PreviewMouseMove="LibraryClip_MouseMove" MouseDoubleClick="LibraryClip_DoubleClick">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Width="125" Padding="7" Margin="3" Background="#F7FAD9">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox Grid.Column="1" x:Name="AudioList" Visibility="Collapsed" Margin="6,0" PreviewMouseLeftButtonDown="LibraryClip_MouseDown" PreviewMouseMove="LibraryClip_MouseMove" MouseDoubleClick="LibraryClip_DoubleClick" />
          <StackPanel Grid.Column="2">
            <TextBlock x:Name="DirectHelpText" Text="Sleep een actie naar het spoor van de acteur. Klik om de actie te bekijken." TextWrapping="Wrap" Margin="5" />
            <DockPanel x:Name="ActionDurationPanel">
              <TextBlock Text="Duur (s), bij herhalen" VerticalAlignment="Center" />
              <TextBox x:Name="ActionDurationBox" Text="3" Width="50" />
            </DockPanel>
            <Button x:Name="InsertActionButton" Content="＋ Actie op tijdlijn" Click="AddAction_Click" />
            <Button x:Name="ImportAudioButton" Content="＋ Eigen audio kiezen…" Click="ImportAudio_Click" Visibility="Collapsed" /><Button x:Name="OwnAudioVoice" Click="OwnAudioVoice_Click" Content="Spraak / muziek…" Visibility="Collapsed" ToolTip="Kies het gebruik en het sprekende personage voor dit bestand." /><Button x:Name="PreviewSoundButton" Content="▶ Beluisteren" Click="PreviewSound_Click" Visibility="Collapsed" />
            <Button x:Name="InsertSoundButton" Content="＋ Geluid op tijdlijn" Click="AddSound_Click" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="EditorPane" Visibility="Collapsed" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Text="Bekijk je film en de acties hieronder. Sla de scène met acties en bewegingen op met Opslaan." Width="400" TextWrapping="Wrap" Margin="12" />
          <Button Content="▶ Bekijk film" Click="Preview_Click" />
          <Button Content="Opslaan" Click="SaveProject_Click" ToolTip="Project opslaan (Ctrl+S)" /><Button Content="MP4 exporteren" Click="ExportMp4_Click" />
          <Button Content="◀ 0,25 s" Tag="-0.25" Click="ShiftClip_Click" />
          <Button Content="0,25 s ▶" Tag="0.25" Click="ShiftClip_Click" />
          <Button Content="Fragment verwijderen" Click="RemoveAction_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="6" Background="#EFF6CC" CornerRadius="7" Padding="7" x:Name="TimelineHost">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel>
          <TextBlock Text="TIJDLIJN" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,8,0" />
          <Button x:Name="PlayButton" Content="▶ Afspelen" Click="Preview_Click" ToolTip="Afspelen/pauze (Spatie)" /><Button x:Name="RazorButton" Content="✂ Knippen (V)" Click="Razor_Click" ToolTip="V: schaar. Klik op het fragment. Esc: weer slepen." />
          <Button x:Name="AddKeyframeButton" Content="＋ Positie" Click="AddKeyframe_Click" />
          <Button Content="＋ Camerashot" Click="AddCameraShot_Click" ToolTip="Bewaar de huidige camerastand op de positie van de afspeelkop" />
          <Button Content="Shot bijwerken" Click="UpdateCameraShot_Click" ToolTip="Vervang het gekozen shot door de huidige camerastand" />
          <Button Content="Shot wissen" Click="DeleteCameraShot_Click" />
          <Button Content="↶" ToolTip="Ongedaan maken (Ctrl+Z)" Click="UndoTimeline_Click" />
          <Button Content="↷" ToolTip="Opnieuw (Ctrl+Y)" Click="RedoTimeline_Click" />
          <TextBlock Text="Scèneduur" VerticalAlignment="Center" Margin="8,0,0,0" /><Slider x:Name="SceneLengthSlider" Minimum="1" Maximum="300" Value="45" TickFrequency="1" IsSnapToTickEnabled="True" Width="120" VerticalAlignment="Center" ValueChanged="SceneLengthSlider_Changed" ToolTip="Schuif om de lengte van deze scène in seconden te kiezen" /><TextBlock x:Name="SceneLengthText" Text="45 s" VerticalAlignment="Center" Margin="2,0" /><TextBox x:Name="SceneDurationBox" Text="45" Width="48" ToolTip="Scèneduur in seconden (1–300)" /><Button Content="✓" Click="SetSceneDuration_Click" ToolTip="Scèneduur toepassen" /><TextBlock x:Name="TimeText" Text="0.00 s / 45 s" VerticalAlignment="Center" Margin="8,0" />
          <TextBlock x:Name="KeyframeCountText" VerticalAlignment="Center" />
          <ToggleButton x:Name="SnapTimeline" Content="Vastklikken 0,1 s" IsChecked="True" VerticalAlignment="Center" Padding="6" Margin="5" />
          <TextBlock Text="Zoom" VerticalAlignment="Center" />
          <Slider x:Name="TimelineZoom" Minimum="0.5" Maximum="4" Value="1" Width="100" VerticalAlignment="Center" ValueChanged="TimelineZoom_Changed" />
          <TextBlock Text="Sleep acties/geluid hierheen · Randen slepen = bijsnijden" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
        </WrapPanel>
        <ScrollViewer Grid.Row="1" x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Timeline_SizeChanged" CanContentScroll="False">
          <Canvas x:Name="TimelineCanvas" Background="Transparent" Focusable="True" AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop" MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseUp" />
        </ScrollViewer>
        <Slider x:Name="TimelineSlider" Minimum="0" Maximum="45" Value="0" Visibility="Collapsed" ValueChanged="TimelineSlider_Changed" />
        <ListBox x:Name="MovieTracks" Visibility="Collapsed" />
      </Grid>
    </Border>
    <TextBlock x:Name="StatusText" Grid.Row="7" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#90BC68" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Sleep om de panelen hoger of lager te maken" />
    <GridSplitter Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#90BC68" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Sleep om de panelen hoger of lager te maken" />
  </Grid>
</Window>




