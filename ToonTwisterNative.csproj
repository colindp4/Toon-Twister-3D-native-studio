<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\ToonTwister.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\ToonTwister.ico" />
    <Compile Remove="Installer\**\*.cs" />
    <Compile Remove="InstallerPayload\**\*.cs" />
    <Content Include="Encoder\**\*" Condition="'$(LeanInstallerBuild)' != 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Handleiding - Nederlands.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- The lean installer build ships no third-party game assets. They are
         provisioned locally by the installer after the user selects a source. -->
    <Content Include="Assets\**\*" Condition="'$(LeanInstallerBuild)' != 'true'" Exclude="Assets\Converted\**\*;Assets\Converted-v2\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
