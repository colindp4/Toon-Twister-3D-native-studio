<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\Resources\ToonTwisterSetup.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\InstallerPayload\ToonTwisterNative.exe" LogicalName="Payload.ToonTwisterNative.exe" />
    <EmbeddedResource Include="..\Tools\AssetConverter\w3d_export.exe" LogicalName="Payload.AssetConverter.w3d_export.exe" />
    <EmbeddedResource Include="..\Tools\AssetConverter\audio_export.exe" LogicalName="Payload.AssetConverter.audio_export.exe" />
  </ItemGroup>
</Project>
